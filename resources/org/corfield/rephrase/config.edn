 :ex-messages
 [["^Unable to resolve symbol: (catch|def|do|if|quote|recur|throw|try|var) in this context$"
   "$1 is a special form, and cannot be used by itself or passed as an argument to a function"]
  ["^Unable to resolve symbol: (.*) in this context$"
   "the name $1 is not defined"]
  ["^Can't take value of a macro: #'(.*)$"
   "$1 is a macro, and cannot be used by itself or passed as an argument to a function"]
  ["^class (.*) cannot be cast to class (.*)$"
   "Expected $2, but was given $1"]
  ["^Cannot cast (.*) to (.*)$"
   "Expected $2, but was given $1"]
  ["^Don't know how to create (.*) from: (.*)$"
   "Expected $1, but was given $2"]
  ["^Cannot invoke \"a function\\.invoke\\(.*\\)\" because the return value of \"Var.getRawRoot\\(\\)\" is null"
   "The function you are trying to call has the value 'nil'"]
  ["^Cannot invoke \"a function\\.invoke\\(.*\\)\" because \"(.*)\" is null"
   "The function you are trying to call, $1, has the value 'nil'"]
  ["^Cannot invoke \".*toString\\(.*\\)\" because \"(.*)\" is null"
   "Expected a string, but was given 'nil', possibly in $1 (which may be in code you are calling)"]
  ["^For input string: (.*)$"
   "The string $1 cannot be converted to a number" java.lang.NumberFormatException]
  ["^Wrong number of args \\(0\\) passed to: (:.*)$"
   "The keyword $1 was used as a function, with no arguments, but it expects one or two arguments"]
  ["^Wrong number of args \\((.*)\\) passed to: (:.*)$"
   "The keyword $2 was used as a function, with $1 arguments, but it expects one or two arguments"]
  ["^Wrong number of args \\(0\\) passed to: (.*)$"
   "$1 was called with no arguments, but it requires at least one argument"]
  ["^Wrong number of args \\(1\\) passed to: (.*)$"
   "$1 was called with one argument, but it expects a different number of arguments"]
  ["^Wrong number of args \\((.*)\\) passed to: (.*)$"
   "$2 was called with $1 arguments, but it expects a different number of arguments"]
  ["^Divide by zero$" "Tried to divide by zero"]]}
