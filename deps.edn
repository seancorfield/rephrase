{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.10.3"}}

 :aliases
 {:optional
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0" :optional true}}}

  :dev
  {:extra-paths ["dev"]}

  ;; versions to test against:
  :1.10 {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :1.11 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}}
  :1.13 {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha7"}}}

  :jolt
  {:extra-deps {jolt-lang/nrepl {:git/url "https://github.com/jolt-lang/nrepl"
                                 ;;:git/tag "v0.2.0" -- waiting for 0.2.1
                                 :git/sha "aad8baef0dfe56d288792017841f37321d8160b1"}
                org.clojure/spec.alpha {:mvn/version "0.6.249"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "2.1.0"}}}

  :runner
  {:main-opts   ["-m" "lazytest.main"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
