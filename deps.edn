{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}}
 :aliases
 {:dev
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
   :extra-paths ["dev"]}
  :test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                io.github.noahtheduke/lazytest {:mvn/version "2.0.0"}}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.13"}
                 slipset/deps-deploy {:mvn/version "0.2.3"}}
          :ns-default build}}}
